# PreCommit AI (LeakGuard) Environment Configuration
APP_NAME="PreCommit AI (LeakGuard)"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# GitHub API Integration (optional default token for increased rate limits)
GITHUB_TOKEN=""
GITHUB_API_BASE_URL="https://api.github.com"

# Local LLM Integration (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_TIMEOUT_SECONDS=30.0

# Storage & File Constraints
MAX_UPLOAD_SIZE_MB=50
TEMP_DIR="/tmp/precommit_ai"

# Logging Configuration
LOG_LEVEL="INFO"

